INCLUDES = ../.. ../model
CLINE_OPTIONS = --qof

ifdef POLY
HOLHEAP = riscv-heap
EXTRA_CLEANS = $(HOLHEAP) riscv-steplib-selftest.log selftest.log

BARE_THYS = ../model/riscvTheory
DEPS = $(patsubst %,%.uo,$(BARE_THYS))

all: $(DEFAULT_TARGETS) $(HOLHEAP)
.PHONY: all

$(HOLHEAP): ../../l3-heap $(DEPS)
	$(protect $(HOLDIR)/bin/hol) buildheap -b $< -o $(HOLHEAP) $(BARE_THYS)

endif

ifdef HOLSELFTESTLEVEL
all: riscv-steplib-selftest.log selftest.log

riscv-steplib-selftest.log: ../../common/testscript.ML riscv_stepLib.uo
	tmp=`mktemp "$${TMPDIR:-.}/stepLibXXXX"` && TESTLIB=riscv_stepLib $(protect $(HOLDIR)/bin/hol) < $< > $$tmp && $(MV) $$tmp $@

# riscv_step_hex on every riscv_dict entry and every sim/tests instruction,
# with the hypotheses of each theorem checked (see selftest.sml)
selftest.log: selftest.sml riscv_stepLib.uo $(HOLHEAP)
	tmp=`mktemp "$${TMPDIR:-.}/stepLibXXXX"` && $(protect $(HOLDIR)/bin/hol) < $< > $$tmp && $(MV) $$tmp $@ || { tail -40 $$tmp; rm -f $$tmp; exit 1; }
endif
