# Holmake builds every theory of this directory: riscv_footprint, riscv_frames,
# riscv_pmp, riscv_isolation and riscv_isolation_example, which do not have the
# step library's riscv_stepTheory as an ancestor (DESIGN.md I11, checked by the
# build of riscv_trap), and riscv_trap, riscv_trap_example, riscv_refine and
# riscv_refine_example, which have (DESIGN.md I14, I18).  ../step is in INCLUDES
# for them and for the heap.
INCLUDES = ../model ../step
CLINE_OPTIONS = --qof -j1

ifdef POLY
HOLHEAP = ../step/riscv-heap
endif
